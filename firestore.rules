rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.platform is string && data.platform in ['android', 'ios', 'web'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCallHistoryEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16 &&
             data.roomCode.matches('^[A-Z0-9\\-]+$') &&
             data.peerName is string && data.peerName.size() >= 1 && data.peerName.size() <= 60 &&
             data.peerPlatform is string && data.peerPlatform in ['android', 'ios', 'web', 'unknown'] &&
             data.direction is string && data.direction in ['outgoing', 'incoming'] &&
             data.status is string && data.status in ['completed', 'missed', 'cancelled'] &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCandidateList(candidates) {
      return candidates is list &&
             candidates.size() <= 40 &&
             (
               candidates.size() == 0 ||
               (
                 candidates[0] is map &&
                 candidates[0].keys().hasAll(['candidate', 'sdpMid', 'sdpMLineIndex']) &&
                 candidates[0].keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex']) &&
                 candidates[0].candidate is string && candidates[0].candidate.size() >= 1 && candidates[0].candidate.size() <= 1024 &&
                 candidates[0].sdpMid is string && candidates[0].sdpMid.size() <= 64 &&
                 candidates[0].sdpMLineIndex is int && candidates[0].sdpMLineIndex >= 0 && candidates[0].sdpMLineIndex <= 16
               )
             );
    }

    function isValidCallRoomCore(data) {
      return data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostDeviceId is string && data.hostDeviceId.size() >= 4 && data.hostDeviceId.size() <= 64 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             data.hostPlatform in ['android', 'ios', 'web'] &&
             data.status in ['waiting', 'connected', 'ended'] &&
             data.offerSdp is string && data.offerSdp.size() >= 10 && data.offerSdp.size() <= 20000 &&
             data.offerType == 'offer' &&
             data.offerEpoch is int && data.offerEpoch >= 1 && data.offerEpoch <= 1000 &&
             data.answerEpoch is int && data.answerEpoch >= 0 && data.answerEpoch <= 1000 &&
             data.renegotiateEpoch is int && data.renegotiateEpoch >= 0 && data.renegotiateEpoch <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGuestFields(data) {
      return data.guestUid is string && data.guestUid.size() >= 1 && data.guestUid.size() <= 128 &&
             data.guestDeviceId is string && data.guestDeviceId.size() >= 4 && data.guestDeviceId.size() <= 64 &&
             data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 60 &&
             data.guestPlatform in ['android', 'ios', 'web'];
    }

    function isValidHostOfferFields(data) {
      return data.hostDeviceId is string && data.hostDeviceId.size() >= 4 && data.hostDeviceId.size() <= 64 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             data.hostPlatform in ['android', 'ios', 'web'] &&
             data.offerSdp is string && data.offerSdp.size() >= 10 && data.offerSdp.size() <= 20000 &&
             data.offerType == 'offer' &&
             data.offerEpoch is int && data.offerEpoch <= 1000;
    }

    function isValidAnswerFields(data) {
      return data.answerSdp is string && data.answerSdp.size() >= 10 && data.answerSdp.size() <= 20000 &&
             data.answerType == 'answer';
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'platform', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'platform', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'platform', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /call_history/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'roomCode', 'peerName', 'peerPlatform',
                           'direction', 'status', 'durationSeconds', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'roomCode', 'peerName', 'peerPlatform',
                           'direction', 'status', 'durationSeconds', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCallHistoryEntry(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidCallHistoryEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().roomCode == existing().roomCode &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'peerName', 'peerPlatform', 'status', 'durationSeconds', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(entryId);
      }
    }

    function canUpdateCallRoom(roomId) {
      let inc = request.resource.data;
      let ex = resource.data;
      let changed = inc.diff(ex).affectedKeys();
      let isHost = request.auth.uid == ex.hostUid;
      let isExistingGuest = ('guestUid' in ex) && request.auth.uid == ex.guestUid;
      return isSignedIn() &&
             isValidId(roomId) &&
             ex.status != 'ended' &&
             inc.hostUid == ex.hostUid &&
             inc.createdAt == ex.createdAt &&
             inc.updatedAt is timestamp &&
             inc.updatedAt <= request.time &&
             (
               // Terminal end by current host or guest
               (
                 (isHost || isExistingGuest) &&
                 inc.status == 'ended' &&
                 changed.hasOnly(['status', 'updatedAt'])
               ) ||
               // Host appends ICE candidates
               (
                 isHost &&
                 changed.hasOnly(['callerCandidates', 'updatedAt']) &&
                 isValidCandidateList(inc.callerCandidates) &&
                 inc.callerCandidates.size() >= ex.callerCandidates.size()
               ) ||
               // Joined guest appends ICE candidates
               (
                 isExistingGuest &&
                 changed.hasOnly(['calleeCandidates', 'updatedAt']) &&
                 isValidCandidateList(inc.calleeCandidates) &&
                 inc.calleeCandidates.size() >= ex.calleeCandidates.size()
               ) ||
               // Host switches device or issues fresh offer for guest handoff
               (
                 isHost &&
                 inc.offerEpoch == ex.offerEpoch + 1 &&
                 inc.answerEpoch == 0 &&
                 inc.callerCandidates.size() == 0 &&
                 inc.calleeCandidates.size() == 0 &&
                 isValidHostOfferFields(inc) &&
                 changed.hasOnly([
                   'hostDeviceId', 'hostName', 'hostPlatform',
                   'offerSdp', 'offerType', 'offerEpoch', 'answerEpoch',
                   'callerCandidates', 'calleeCandidates', 'updatedAt'
                 ])
               ) ||
               // Guest joins, switches device, or answers renegotiated host offer
               (
                 inc.guestUid == request.auth.uid &&
                 inc.calleeCandidates.size() == 0 &&
                 isValidGuestFields(inc) &&
                 changed.hasOnly([
                   'guestUid', 'guestDeviceId', 'guestName', 'guestPlatform',
                   'answerSdp', 'answerType', 'answerEpoch', 'renegotiateEpoch',
                   'calleeCandidates', 'status', 'updatedAt'
                 ]) &&
                 (
                   (
                     ((!('guestUid' in ex) && ex.status == 'waiting') || isExistingGuest) &&
                     inc.status == 'connected' &&
                     inc.answerEpoch == ex.offerEpoch &&
                     inc.renegotiateEpoch == ex.renegotiateEpoch &&
                     isValidAnswerFields(inc)
                   ) ||
                   (
                     isExistingGuest &&
                     inc.status == ex.status &&
                     inc.renegotiateEpoch == ex.renegotiateEpoch + 1 &&
                     inc.renegotiateEpoch <= 1000 &&
                     inc.answerEpoch == 0
                   )
                 )
               )
             );
    }

    match /calls/{roomId} {
      // Direct room lookup by exact room code for authenticated participants
      allow get: if isSignedIn() && isValidId(roomId);
      // List strictly scoped to rooms where the caller is host or guest
      allow list: if isSignedIn() &&
                     (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid);

      // Host creates a waiting signaling room with initial SDP offer
      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       incoming().offerEpoch == 1 &&
                       incoming().answerEpoch == 0 &&
                       incoming().renegotiateEpoch == 0 &&
                       incoming().keys().hasAll([
                         'hostUid', 'hostDeviceId', 'hostName', 'hostPlatform', 'status',
                         'offerSdp', 'offerType', 'offerEpoch', 'answerEpoch', 'renegotiateEpoch',
                         'callerCandidates', 'calleeCandidates', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'hostUid', 'hostDeviceId', 'hostName', 'hostPlatform', 'status',
                         'offerSdp', 'offerType', 'offerEpoch', 'answerEpoch', 'renegotiateEpoch',
                         'callerCandidates', 'calleeCandidates', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCallRoomCore(incoming()) &&
                       isValidCandidateList(incoming().callerCandidates) &&
                       isValidCandidateList(incoming().calleeCandidates);

      allow update: if canUpdateCallRoom(roomId);

      allow delete: if isSignedIn() &&
                       isValidId(roomId) &&
                       resource.data.hostUid == request.auth.uid;
    }
  }
}
